<!--
  DexVision Level 2 task-board scene.

  This scene contains the shared board plus reach_touch_target and button_press
  fixtures. Movable-object fixtures belong to later checkpoints.
-->
<mujoco model="dexvision_task_board">
  <include file="menagerie/shadow_hand/right_hand_dexvision.xml"/>

  <statistic extent="0.55" center="0.02 0 0.18"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global azimuth="220" elevation="-28"/>
  </visual>

  <asset>
    <texture name="task_skybox" type="skybox" builtin="gradient"
      rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="task_floor_texture" type="2d" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="task_floor_material" texture="task_floor_texture"
      texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="task_board_material" rgba="0.28 0.31 0.34 1"/>
    <material name="task_target_material" rgba="0.9 0.2 0.15 1"/>
    <material name="button_left_material" rgba="0.2 0.55 0.95 1"/>
    <material name="button_center_material" rgba="0.95 0.75 0.15 1"/>
    <material name="button_right_material" rgba="0.25 0.8 0.4 1"/>
  </asset>

  <worldbody>
    <light name="task_fill_light" pos="0 0 1"/>
    <light name="task_key_light" pos="0.3 -0.2 1.5" dir="0 0 -1"
      directional="true"/>
    <geom name="task_floor" pos="0 0 -0.12" size="0 0 0.05" type="plane"
      material="task_floor_material"/>
    <geom name="task_table" pos="0 0 -0.06" size="0.22 0.18 0.025"
      type="box" material="task_board_material"/>
    <geom name="task_board" pos="0.18 0 0.49" size="0.015 0.18 0.12"
      type="box" material="task_board_material" contype="0" conaffinity="0"/>

    <site name="reach_target_left" pos="0.14 -0.10 0.45" type="cylinder"
      size="0.025 0.025" euler="0 1.5708 0"
      material="task_target_material" group="1"/>
    <site name="reach_target_center" pos="0.14 0 0.49" type="cylinder"
      size="0.025 0.025" euler="0 1.5708 0"
      material="task_target_material" group="1"/>
    <site name="reach_target_right" pos="0.14 0.06 0.51" type="cylinder"
      size="0.025 0.025" euler="0 1.5708 0"
      material="task_target_material" group="1"/>

    <body name="reach_target_marker" mocap="true" pos="0.14 0 0.49"
      quat="1 0 0 0">
      <geom name="active_reach_target" type="sphere" size="0.025"
        rgba="1 0.85 0.05 0.9" group="1" contype="1" conaffinity="1"/>
    </body>

    <body name="button_left" pos="0.145 -0.08 0.40">
      <joint name="button_left_joint" type="slide" axis="1 0 0"
        range="0 0.02" limited="true" damping="2" stiffness="40"
        springref="0"/>
      <geom name="button_left_geom" type="cylinder" size="0.018 0.008"
        euler="0 1.5708 0" mass="0.04" material="button_left_material"/>
      <site name="button_left_site" pos="-0.008 0 0" type="sphere"
        size="0.006" rgba="0.2 0.55 0.95 0.5"/>
    </body>
    <body name="button_center" pos="0.145 0 0.40">
      <joint name="button_center_joint" type="slide" axis="1 0 0"
        range="0 0.02" limited="true" damping="2" stiffness="40"
        springref="0"/>
      <geom name="button_center_geom" type="cylinder" size="0.018 0.008"
        euler="0 1.5708 0" mass="0.04" material="button_center_material"/>
      <site name="button_center_site" pos="-0.008 0 0" type="sphere"
        size="0.006" rgba="0.95 0.75 0.15 0.5"/>
    </body>
    <body name="button_right" pos="0.145 0.08 0.40">
      <joint name="button_right_joint" type="slide" axis="1 0 0"
        range="0 0.02" limited="true" damping="2" stiffness="40"
        springref="0"/>
      <geom name="button_right_geom" type="cylinder" size="0.018 0.008"
        euler="0 1.5708 0" mass="0.04" material="button_right_material"/>
      <site name="button_right_site" pos="-0.008 0 0" type="sphere"
        size="0.006" rgba="0.25 0.8 0.4 0.5"/>
    </body>

    <body name="dexvision_hand_base_target" mocap="true" pos="0 0 0.14"
      quat="1 0 0 0">
      <site name="dexvision_hand_base_target_site" type="sphere" size="0.012"
        rgba="0 0.8 1 0.6"/>
    </body>
    <camera name="task_overview" pos="0.58 -0.82 0.48"
      euler="1.15 0 0.58"/>
  </worldbody>

  <equality>
    <weld name="dexvision_hand_base_weld" body1="dexvision_hand_base_target"
      body2="rh_forearm" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>
</mujoco>
